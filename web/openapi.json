  "components": {
    "schemas": {
      "AuthStatus": {
        "required": [
          "signUpOpen",
          "user"
        ],
        "type": "object",
        "properties": {
          "signUpOpen": {
            "type": "boolean"
          },
          "user": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CurrentUser"
              }
            ]
          }
        }
      },
      "BranchInfo": {
        "required": [
          "name",
          "sha",
          "isRemote"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sha": {
            "type": "string"
          },
          "isRemote": {
            "type": "boolean"
          }
        }
      },
      "CreateLlmProviderRequest": {
        "required": [
          "name",
          "defaultModel",
          "apiKey"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "defaultModel": {
            "type": "string"
          },
          "apiKey": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/LlmProviderKind"
          },
          "baseUrl": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateProjectRequest": {
        "required": [
          "name",
          "slug",
          "key"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        }
      },
      "CreateRepositoryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "remoteUrl": {
            "type": [
              "null",
              "string"
            ]
          },
          "defaultBranch": {
            "type": [
              "null",
              "string"
            ]
          },
          "credential": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CredentialInput"
              }
            ]
          }
        }
      },
      "CreateTicketRequest": {
        "required": [
          "title"
        ],
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "default": ""
          },
          "priority": {
            "$ref": "#/components/schemas/TicketPriority"
          },
          "criteria": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CredentialInput": {
        "required": [
          "kind"
        ],
