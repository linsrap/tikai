# Copy to .env and adjust. Never commit .env.

# Required by compose.yml: encrypts the hub's key ring (login cookies, stored git credentials and LLM keys).
# Random, at least 32 characters. Keep a copy somewhere safe: without it the keys cannot be read.
#   Linux/macOS: openssl rand -base64 32
#   PowerShell (5.1 and 7): $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
TIKAI_SECRET=

# Database password, used by compose.yml and compose.dev.yml. Change it for a real installation.
DB_PASSWORD=tikai

# compose.yml: where the web app is reachable. 127.0.0.1 = this machine only;
# set TIKAI_BIND=0.0.0.0 to open it to your network (put a TLS reverse proxy in front then).
TIKAI_BIND=127.0.0.1
TIKAI_PORT=8080

# compose.dev.yml: Postgres port on this machine for local development
DB_PORT=5432
